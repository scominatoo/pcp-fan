# Mesmo banco da API (pcp-homol-api)
DATABASE_URL=postgresql://pcp:pcp_dev_secret@localhost:5432/pcp_homol?schema=public

# Pasta dos arquivos COBOL legados (backup mais recente)
LEGACY_DATA_PATH=/Users/scominato/projetos/fanandri/FANANDRI

# Backup anterior — usado só para arquivos ausentes no backup novo (ex.: PCPA70XI.DAT, PCPA70C.DAT)
LEGACY_DATA_PATH_FALLBACK=/Users/scominato/FANANDRI
