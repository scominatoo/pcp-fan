[Unit]
Description=PCP Homologacao — API NestJS (porta 3000)
Documentation=file:///home/pcp/pcp-fan/README.md
After=network.target pcp-postgres.service
Requires=pcp-postgres.service

[Service]
Type=simple
User=pcp
Group=pcp
WorkingDirectory=/home/pcp/pcp-fan/pcp-homol-api
EnvironmentFile=/home/pcp/pcp-fan/pcp-homol-api/.env
Environment=PATH=/home/pcp/.nvm/versions/node/v22.23.1/bin:/home/pcp/micromamba/envs/pcp-pg/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=BACKEND_PORT=3000
StartLimitIntervalSec=60
StartLimitBurst=5
ExecStartPre=/home/pcp/micromamba/envs/pcp-pg/bin/pg_isready -h 127.0.0.1 -p 5432 -U pcp -d pcp_homol
ExecStart=/home/pcp/.nvm/versions/node/v22.23.1/bin/node dist/main
KillMode=control-group
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
